generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ValueItem {
  id        String   @id
  data      Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("value_items")
}

model ValueSetting {
  id        String   @id
  data      Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("value_settings")
}

model TradeAd {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  offering      String   @default("")
  offeringItems Json     @default("[]") @map("offering_items")
  wants         String   @default("")
  wantsItems    Json     @default("[]") @map("wants_items")
  notes         String   @default("")
  poster        Json
  posterDiscordId String? @map("poster_discord_id")
  createdAt     DateTime @default(now()) @map("created_at")
  expiresAt      DateTime @default(dbgenerated("(now() + '24:00:00'::interval)")) @map("expires_at")

  @@index([createdAt(sort: Desc)])
  @@index([expiresAt(sort: Desc), createdAt(sort: Desc)])
  @@index([posterDiscordId, expiresAt])
  @@map("trade_ads")
}

model TradePostLimit {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime @map("reset_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([resetAt])
  @@map("trade_post_limits")
}

model AdminLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action     String
  actor      Json
  changes    Json     @default("[]")
  summary    String
  targetId   String?  @map("target_id")
  targetName String?  @map("target_name")
  targetType String   @map("target_type")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@map("admin_logs")
}
